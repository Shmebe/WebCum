# LAN address of the RK3399 host. Required for browser WebRTC playback.
SERVER_IP=192.168.1.50

# USB camera device. Its H.264, 1280x720, 15 FPS settings are defined in
# mediamtx.yml because MediaMTX hook commands do not inherit these variables.
CAMERA_DEVICE=/dev/video5

# Gesture analysis is deliberately capped to protect audio playback and CPU.
ANALYSIS_FPS=5
ANALYSIS_MAX_WIDTH=640
GESTURE_MIN_SCORE=0.65

# Hardware encoder for the small visualized gesture stream.
VPU_ENCODER_DEVICE_1=/dev/video3
VPU_ENCODER_DEVICE_2=/dev/video4
ANNOTATED_VIDEO_CODEC=h264_v4l2m2m
