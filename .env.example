# LAN address of the RK3399 host. Required for browser WebRTC playback.
SERVER_IP=192.168.1.50

# Obtain these values with: v4l2-ctl -d /dev/video5 --list-formats-ext
CAMERA_DEVICE=/dev/video5
CAMERA_INPUT_FORMAT=mjpeg
CAMERA_SIZE=1280x720
CAMERA_FPS=15

# Conservative default for Wi-Fi and low CPU/VPU load.
VIDEO_BITRATE=1500k

# Typical RK3399 VPU encoder device nodes; change only if your system differs.
VPU_ENCODER_DEVICE_1=/dev/video3
VPU_ENCODER_DEVICE_2=/dev/video4
